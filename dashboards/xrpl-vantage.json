{
  "title": "XRPL Vantage",
  "uid": "xrpl-vantage",
  "description": "What an XRP Ledger node can see of the network around it, and where it stands in it.",
  "tags": [
    "xrpl",
    "rippled",
    "xrpld"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(xrpl_up, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Node"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Where this node stands",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Server state",
      "description": "Ordered by how far the node has got towards being useful.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "xrpl_server_state{instance=~\"$instance\"}",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "disconnected",
                  "color": "red"
                },
                "1": {
                  "text": "connected",
                  "color": "orange"
                },
                "2": {
                  "text": "syncing",
                  "color": "orange"
                },
                "3": {
                  "text": "tracking",
                  "color": "yellow"
                },
                "4": {
                  "text": "full",
                  "color": "green"
                },
                "5": {
                  "text": "proposing",
                  "color": "green"
                },
                "6": {
                  "text": "validating",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Peers",
      "description": "",
      "id": 3,
