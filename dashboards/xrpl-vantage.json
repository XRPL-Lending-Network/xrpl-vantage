    {
      "type": "timeseries",
      "title": "Master key linkage over time",
      "description": "The linkage is written by two paths that race each other, so on an affected validator this flips back and forth rather than staying broken. A flat line at 1 is what healthy looks like.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "xrpl_registry_master_key_present{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} master key linked",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "K"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "xrpl_registry_listed{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} listed",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "T"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
